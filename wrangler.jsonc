{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yonder",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "Session" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }],
  "ratelimits": [{
    "name": "PAIRING_LIMITER",
    // Choose an unused positive numeric namespace in your Cloudflare account.
    "namespace_id": "10014001",
    "simple": { "limit": 30, "period": 60 }
  }],
  "vars": { "INVITE_TTL_SECONDS": "600", "SHARING_TTL_SECONDS": "3600" },
  "observability": { "enabled": false },
  "upload_source_maps": false
  // Platform operational/request metadata can still exist. See docs/CLOUDFLARE_SETUP.md.
}
